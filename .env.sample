# Copy to .env (gitignored) and fill in real values, or set these as
# GitHub Actions secrets / your host's environment variables directly.

# --- Database ---------------------------------------------------------------
# This service owns writes to its OWN new schemas only (chat.*, auth.line_identity,
# auth.line_link_code, notify.*) -- see ADR 0001's "one inference worth double-checking"
# note. It never migrates the schema itself; that's the `database` repo's job (Flyway).
# SQLAlchemy async needs the asyncpg driver in the URL, not the plain postgresql:// scheme.
DATABASE_URL=postgresql+asyncpg://neondb_owner:<password>@<host>/neondb?ssl=require

# --- Existing backends (the seam -- ADR 0001) --------------------------------
# Reads go to Kotlin (GET /forms/{formId}), writes go to Go (POST /tasks).
# Neither of these is optional -- there is no local/offline mode for this service.
KOTLIN_BACKEND_URL=http://localhost:3001/api/v1
GO_BACKEND_URL=http://localhost:8080

# --- LINE (line-bot-sdk-python) ----------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=

# --- LLM (LiteLLM -- ADR 0004) ------------------------------------------------
# `model` is a LiteLLM-format string, e.g. "gpt-4o-mini", "claude-3-5-haiku-20241022",
# "gemini/gemini-1.5-flash" -- switching providers is a config change here, not code.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- Misc ---------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]
